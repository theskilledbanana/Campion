rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
          && data.authorId == request.auth.uid
          && data.authorName is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && data.createdAt == request.time
          && data.likes is number && data.likes >= 0;
    }

    function isValidComment(data) {
      return data.postId is string && isValidId(data.postId)
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.authorId == request.auth.uid
          && data.authorName is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.authorId == 'passcode-admin-001'
          && data.authorName is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && data.createdAt == request.time;
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 32
          && data.avatarUrl is string && data.avatarUrl.size() <= 1000
          && data.stats is map
          && data.settings is map
          && data.updatedAt == request.time;
    }

    // 4. Collection Match Blocks

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidUserProfile(incoming())
          && incoming().keys().hasAll(['displayName', 'avatarUrl', 'stats', 'settings', 'updatedAt'])
          && incoming().keys().size() <= 5;
    }

    // Forum Messages (Real-time Chat)
    match /forum_messages/{msgId} {
      allow read: if true;
      allow create: if incoming().authorId == 'passcode-admin-001' && isValidMessage(incoming())
          && incoming().keys().hasAll(['content', 'authorId', 'authorName', 'createdAt'])
          && incoming().keys().size() <= 6;
      allow update: if isOwner(existing().authorId);
      allow delete: if isOwner(existing().authorId) || (existing().authorId == 'passcode-admin-001');
    }
    
    // Forum Posts (Legacy)
    match /forum_posts/{postId} {
      allow read: if true; // Publicly readable
      
      allow create: if isSignedIn() && isValidPost(incoming()) 
          && incoming().keys().hasAll(['title', 'content', 'authorId', 'authorName', 'createdAt', 'likes'])
          && incoming().keys().size() <= 7;
          
      allow update: if isSignedIn() && (
        (isOwner(existing().authorId) && isValidPost(incoming()) 
         && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'likes']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) // Allow others to like (simplified for now)
      );
      
      allow delete: if isOwner(existing().authorId);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        
        allow create: if isSignedIn() && isValidComment(incoming())
            && incoming().postId == postId
            && exists(/databases/$(database)/documents/forum_posts/$(postId))
            && incoming().keys().hasAll(['postId', 'content', 'authorId', 'authorName', 'createdAt'])
            && incoming().keys().size() <= 6;
            
        allow update: if isOwner(existing().authorId) && isValidComment(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['content']);
            
        allow delete: if isOwner(authorId);
      }
    }
  }
}
