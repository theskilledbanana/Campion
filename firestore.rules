rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helper ---
    
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'username', 'playTime', 'updatedAt'])
        && data.keys().size() == 4
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 32
        && data.playTime is int && data.playTime >= 0
        && data.updatedAt == request.time;
    }

    // --- Collections ---

    match /leaderboard/{userId} {
      // Identity Poisoning Guard
      allow get: if isValidId(userId);
      
      // Mandatory Read Check: allow listing but ensure no PII leakage (usernames are public)
      allow list: if isSignedIn(); 

      allow create: if isOwner(userId) 
        && isValidLeaderboardEntry(incoming());

      allow update: if isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == existing().userId // Immutable field
        && (
          // Action: Update Progress
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'playTime', 'updatedAt'])
        );

      allow delete: if isOwner(userId);
    }
  }
}
