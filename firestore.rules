rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.firebaseUid == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
          && data.authorId == request.auth.uid
          && data.authorName is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && data.createdAt == request.time
          && data.likes is number && data.likes >= 0;
    }

    function isValidComment(data) {
      return data.postId is string && isValidId(data.postId)
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.authorId == request.auth.uid
          && data.authorName is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.authorName is string
          && data.authorId is string
          && data.authorRole is string
          && data.passcode is string
          && (data.authorPhoto == null || data.authorPhoto is string)
          && (data.firebaseUid == null || data.firebaseUid is string)
          && data.createdAt == request.time;
    }

    function isPasscodeAuth(data) {
      return data.passcode == '5012' || data.passcode == '3012';
    }

    function isAuthorized() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.status == 'active';
    }

    function isCeo() {
      return isSignedIn() && (
             (request.auth.token.email == "mandyfmcgregor@gmail.com") ||
             (exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.role == 'ceo')
      );
    }

    match /authorized_users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        (request.auth.uid == userId && (
          incoming().role != 'ceo' || 
          incoming().passcode == '3012' || 
          request.auth.token.email == "mandyfmcgregor@gmail.com"
        )) ||
        isCeo()
      );
      allow delete: if isCeo();
    }

    match /forum_messages/{msgId} {
      allow read: if true;
      allow create: if isPasscodeAuth(incoming()) 
                   && isValidMessage(incoming())
                   && !exists(/databases/$(database)/documents/banned_clients/$(incoming().authorId));
      allow update: if false;
      allow delete: if isCeo();
    }

    match /game_metrics/{gameId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /game_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isCeo();
    }

    match /banned_clients/{clientId} {
      allow read: if true;
      allow create, update, delete: if isCeo();
    }
    
    // Forum Posts (Legacy)
    match /forum_posts/{postId} {
      allow read: if true; // Publicly readable
      
      allow create: if isSignedIn() && isValidPost(incoming()) 
          && incoming().keys().hasAll(['title', 'content', 'authorId', 'authorName', 'createdAt', 'likes'])
          && incoming().keys().size() <= 7;
          
      allow update: if isSignedIn() && (
        (isOwner(existing().authorId) && isValidPost(incoming()) 
         && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'likes']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) // Allow others to like (simplified for now)
      );
      
      allow delete: if isOwner(existing().authorId);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        
        allow create: if isSignedIn() && isValidComment(incoming())
            && incoming().postId == postId
            && exists(/databases/$(database)/documents/forum_posts/$(postId))
            && incoming().keys().hasAll(['postId', 'content', 'authorId', 'authorName', 'createdAt'])
            && incoming().keys().size() <= 6;
            
        allow update: if isOwner(existing().authorId) && isValidComment(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['content']);
            
        allow delete: if isOwner(authorId);
      }
    }
  }
}
